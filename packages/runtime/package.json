{
  "name": "@browser-agents/runtime",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./vite": {
      "types": "./dist/vite-plugins.d.ts",
      "import": "./dist/vite-plugins.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node test/node-context.test.mjs && node test/agent-runtime.test.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.3.2",
    "@noble/hashes": "2.0.1",
    "buffer": "6.0.3",
    "deepagents": "1.16.2",
    "langchain": "1.6.0",
    "langsmith": "0.9.0",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "util": "0.12.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  }
}
