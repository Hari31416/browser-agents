+++ b/lib/utils/async_context.mjs
@@ -0,0 +1,4 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+export const hasNativeAsyncStorage = true;
+export const createNativeAsyncStorage = () => new AsyncLocalStorage();
+export const captureNativeSnapshot = () => AsyncLocalStorage.snapshot();
