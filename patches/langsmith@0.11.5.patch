diff --git a/lib/utils/async_context.browser.mjs b/lib/utils/async_context.browser.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..37ba90b968595c77676bfed7f12ec21e3af4ce11
--- /dev/null
+++ b/lib/utils/async_context.browser.mjs
@@ -0,0 +1,5 @@
+// Browser support deliberately has no implicit async context.
+// Callers pass execution state explicitly and reject tracing requests.
+export const hasNativeAsyncStorage = false;
+export const createNativeAsyncStorage = () => undefined;
+export const captureNativeSnapshot = () => undefined;
